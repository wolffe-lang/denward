//! Test-only binary stream driver, never installed and never a backup command.
//! Key input is a private file, never argv contents or an environment value.
use age
use std.fs
use std.str as text

error KeyInputErrors = {io, key, budget}

fn key_file(path: str, secret: bool) -> List[List[byte]] ! KeyInputErrors {
    var file = fs.open(path) else |_| { return io }
    var raw = List[byte]()
    var part = List[byte]()
    var ended = false
    while !ended {
        let n = fs.read_into(mut file, mut part, 8193 - raw.len) else |e| match e {
            eof => { ended = true; 0 },
            io => { return io },
        }
        if !ended && n == 0 { return io }
        for b in part { if !ended { (mut raw).push(b) } }
        if raw.len > 8192 { return budget }
    }
    fs.close(take file) else |_| { return io }
    let decoded = str_from_utf8(raw) else |_| { return key }
    var keys = List[List[byte]]()
    for line in text.split(decoded, "\n") {
        if line != "" && !text.starts_with(line, "#") {
            if keys.len == 64 { return budget }
            let bytes = if secret { age.identity(line)? } else { age.recipient(line)? }
            (mut keys).push(bytes)
        }
    }
    keys
}

fn main() -> int {
    let args = env_args()
    if args.len != 2 || (args[0] != "decrypt" && args[0] != "encrypt") {
        eprint("ERROR usage")
        return 2
    }
    let keys = key_file(args[1], args[0] == "decrypt") else |e| {
        eprint("ERROR {e}")
        return 1
    }
    var source = fs.stdin()
    var sink = fs.stdout()
    if args[0] == "decrypt" {
        let count = age.decrypt(mut source, mut sink, keys) else |e| {
            eprint("ERROR {e}")
            return 1
        }
        if count < 0 { return 1 }
    } else {
        let count = age.encrypt(mut source, mut sink, keys) else |e| {
            eprint("ERROR {e}")
            return 1
        }
        if count < 0 { return 1 }
    }
    0
}
