//! Internal ordinary binary age v1 X25519 codec. Not installed or used by
//! the refusal-only command. Requires independent review before real use.
//! Key codecs are deliberately owned by std; never render secret inputs.

use std.bech32
use std.base64
use std.str as text
use std.bytes
use std.fs
use std.os.random
use std.x.crypto.curve25519
use std.x.crypto.sha2
use std.x.crypto.chacha20

/// Exact native X25519 recipient, one case, BIP-173 and canonical 32 bytes.
/// `key` never contains input or a repaired spelling.
pub fn recipient(s: str) -> List[byte] ! {key} {
    bech32.decode_bytes(s, "age", 32) else |parse| { return key }
}

/// Exact native X25519 identity. Ordinary bytes are not secure storage.
pub fn identity(s: str) -> List[byte] ! {key} {
    bech32.decode_bytes(s, "age-secret-key-", 32) else |parse| { return key }
}

/// Lowercase public recipient spelling. No other profile is generated.
pub fn recipient_text(b: List[byte]) -> str ! {key} {
    if b.len != 32 { return key }
    bech32.encode_bytes("age", b) else |parse| { return key }
}

/// Uppercase secret-identity presentation. Not fixed-time and never logged.
pub fn identity_text(b: List[byte]) -> str ! {key} {
    if b.len != 32 { return key }
    let encoded = bech32.encode_bytes("age-secret-key-", b) else |parse| { return key }
    text.upper(encoded)
}

/// Structurally validated X25519 stanza. Not an authenticated recipient.
pub struct Stanza {
    share: List[byte],
    body: List[byte],
}

/// Original MAC transcript and decoded tag. Unknown stanzas are included
/// verbatim in transcript, but never executed. count includes unknown types.
/// Parsed syntax is NOT header authentication or a backup-verification claim.
pub struct Header {
    transcript: List[byte],
    tag: List[byte],
    stanzas: List[Stanza],
    count: int,
}

/// Malformed syntax, application admission cap, or absent version/profile.
/// Named values carry no input and do not trap.
pub error HeaderErrors = {header, budget, unsupported}

// Limit counts the LF as part of a raw line. Never copy an unbounded line.
fn line_end(raw: List[byte], start: int, limit: int) -> int ! {header, budget} {
    var end = start
    while end < raw.len {
        if end - start >= limit { return budget }
        if raw[end] == 10 as byte { return end }
        end += 1
    }
    header
}

fn ascii(raw: List[byte], start: int, end: int) -> str ! {header} {
    for i in start..end {
        if raw[i] < 32 as byte || raw[i] > 126 as byte { return header }
    }
    str_from_utf8(raw[start..end]) else |_| { return header }
}

/// Parse exactly one raw header, including the last LF and no payload.
/// Validate every supported stanza before any KDF/unwrap. Error values contain
/// no raw input. Original bytes, never a re-encoded tree, are authenticated.
/// Bounds are application admission, not universal age maxima.
pub fn parse_header(raw: List[byte]) -> Header ! HeaderErrors {
    if raw.len > 1048576 { return budget }
    let first_end = line_end(raw, 0, 4096)?
    let first = ascii(raw, 0, first_end)?
    if first != "age-encryption.org/v1" {
        if text.starts_with(first, "age-encryption.org/") ||
            first == "-----BEGIN AGE ENCRYPTED FILE-----" {
            return unsupported
        }
        return header
    }
    var at = first_end + 1
    var stanzas = List[Stanza]()
    var count = 0
    var scrypt_seen = false
    while at < raw.len {
        let end = line_end(raw, at, 4096)?
        let line = ascii(raw, at, end)?
        if text.starts_with(line, "---") {
            if count == 0 ||
                line.len != 47 ||
                !text.starts_with(line, "--- ") ||
                end + 1 != raw.len {
                return header
            }
            let tag = base64.decode_raw(line[4..line.len]) else |parse| { return header }
            if tag.len != 32 { return header }
            return Header {
                transcript: raw[0..at + 3],
                tag: tag,
                stanzas: stanzas,
                count: count,
            }
        }
        if !text.starts_with(line, "-> ") || line.len < 4 { return header }
        if line[line.len - 1..line.len] == " " || text.contains(line, "  ") { return header }
        let args = text.split(line[3..line.len], " ")
        count += 1
        if count > 64 { return budget }
        if args[0] == "scrypt" { scrypt_seen = true }
        if scrypt_seen && count > 1 { return header }
        at = end + 1
        var encoded = List[byte]()
        var final_line = false
        while !final_line {
            let body_end = line_end(raw, at, 65) else |_| { return header }
            let columns = body_end - at
            for i in at..body_end { (mut encoded).push(raw[i]) }
            final_line = columns < 64
            at = body_end + 1
        }
        let body_text = str_from_utf8(encoded) else |_| { return header }
        let body = base64.decode_raw(body_text) else |parse| { return header }
        if args[0] == "X25519" {
            if args.len != 2 || body.len != 32 { return header }
            let share = base64.decode_raw(args[1]) else |parse| { return header }
            if share.len != 32 { return header }
            (mut stanzas).push(Stanza { share: share, body: body })
        }
    }
    header
}

/// Creation admission: malformed recipient, bounded work, or unqualified OS.
/// Provider failure after admission still traps under the pinned std contract.
pub error CreationErrors = {key, budget, entropy_unqualified}

/// Header recovery: bad key input or syntax, work cap, unsupported profile,
/// no recipient match, or full header-MAC failure. No input in a row value.
pub error RecoveryErrors = {key, header, budget, unsupported, no_match, hmac}

/// Private per-encrypt creation state; never returned by a production API.
/// File keys are confidential ordinary region-owned bytes, not erased storage.
struct Created {
    raw: List[byte],
    file_key: List[byte],
    payload_nonce: List[byte],
}

fn append(mut dst: List[byte], src: List[byte]) {
    for b in src { (mut dst).push(b) }
}

fn zeros(n: int) -> List[byte] {
    var out = List[byte]()
    for _ in 0..n { (mut out).push(0 as byte) }
    out
}

fn wrapping_key(share: List[byte], recipient: List[byte], agreement: List[byte]) -> List[byte] {
    var salt = copy share
    append(mut salt, recipient)
    sha2.hkdf256(salt, agreement, "age-encryption.org/v1/X25519".bytes(), 32)
}

fn header_tag(file_key: List[byte], transcript: List[byte]) -> List[byte] {
    let h = sha2.hkdf256(List[byte](), file_key, "header".bytes(), 32)
    sha2.hmac256(h, transcript)
}

/// Create an ordinary age X25519 header using only the guarded OS source.
/// All draws and wraps complete before returning any ciphertext to a caller.
/// Private to one encrypt call so no caller can retain/reuse raw creation
/// key/nonce state. There is no deterministic-entropy parameter or fallback.
fn create_header(recipients: List[List[byte]]) -> Created ! CreationErrors {
    if recipients.len < 1 { return key }
    if recipients.len > 64 { return budget }
    for r in recipients { if r.len != 32 { return key } }
    random.require_ready()?
    let draws = random.bytes(32 + 32 * recipients.len)?
    let file_key = draws[0..16]
    let payload_nonce = draws[16..32]
    var raw = "age-encryption.org/v1\n".bytes()
    for i in 0..recipients.len {
        // Copy only the public stanza bytes out. Temporary scalar, agreement,
        // salt and wrapping-key allocations end here; no erasure is claimed.
        region stanza {
            let ephemeral = draws[32 + 32 * i..64 + 32 * i]
            let share = curve25519.x25519_base(ephemeral)
            let agreement = curve25519.x25519(ephemeral, recipients[i]) else |zero| { return key }
            let wrap_key = wrapping_key(share, recipients[i], agreement)
            let body = chacha20.seal(wrap_key, zeros(12), List[byte](), file_key)
            let line = "-> X25519 {base64.encode_raw(share)}\n{base64.encode_raw(body)}\n"
            append(mut raw, line.bytes())
        }
    }
    append(mut raw, "---".bytes())
    let tag = header_tag(file_key, raw)
    append(mut raw, " {base64.encode_raw(tag)}\n".bytes())
    Created { raw: raw, file_key: file_key, payload_nonce: payload_nonce }
}

/// Deterministic header recovery. Never calls require_ready or draws entropy.
/// All structurally known stanzas were validated by parse_header. Repeat that
/// safety check here because this internal test surface accepts a Header value.
/// A zero agreement aborts even alongside a usable stanza. Authentication is
/// full-width and covers original transcript bytes, including unknown stanzas.
/// Only the first identity-major/stanza candidate that unwraps controls the
/// header MAC, even if a later candidate would authenticate. Returned file-key
/// material is for verification only; never reuse it to create another payload.
pub fn open_header(parsed: Header, identities: List[List[byte]]) -> List[byte] ! RecoveryErrors {
    if identities.len < 1 { return key }
    if identities.len > 64 || parsed.stanzas.len > 64 { return budget }
    if parsed.stanzas.len > 64 / identities.len { return budget }
    for s in identities { if s.len != 32 { return key } }
    for stanza in parsed.stanzas {
        if stanza.share.len != 32 || stanza.body.len != 32 { return header }
    }
    if parsed.stanzas.len == 0 { return unsupported }
    var selected = List[byte]()
    for identity in identities {
        for stanza in parsed.stanzas {
            region attempt {
                let recipient = curve25519.x25519_base(identity)
                let agreement = curve25519.x25519(identity, stanza.share) else |zero| {
                    return header
                }
                let wrap_key = wrapping_key(stanza.share, recipient, agreement)
                let candidate = chacha20.open(
                    wrap_key,
                    zeros(12),
                    List[byte](),
                    stanza.body,
                ) else |tag| { List[byte]() }
                if candidate.len == 16 && selected.len == 0 {
                    append(mut selected, candidate)
                }
            }
        }
    }
    if selected.len == 16 {
        let want = header_tag(selected, parsed.transcript)
        if bytes.is_equal_fixed_work(want, parsed.tag) { return selected }
        return hmac
    }
    no_match
}

/// Increment the full 88-bit big-endian STREAM counter. `budget` refuses a
/// malformed width or carry beyond the last value, before any nonce reuse.
pub fn next_counter(counter: List[byte]) -> List[byte] ! {budget} {
    var out = copy counter
    advance_counter(mut out)?
    out
}

fn advance_counter(mut counter: List[byte]) -> () ! {budget} {
    if counter.len != 11 { return budget }
    var i = 11
    while i > 0 {
        i -= 1
        if counter[i] != 255 as byte {
            counter[i] = (counter[i] as int + 1) as byte
            return
        }
        counter[i] = 0 as byte
    }
    budget
}

/// Safe stream outcomes: malformed key/header, admission cap, unsupported
/// profile, wrong key, header MAC, payload tag, truncated framing, descriptor
/// I/O/zero progress, or entropy_unqualified. No outcome carries secret input.
/// OS-random provider traps are NOT caught or renamed. An error is never a
/// complete backup; an authenticated prefix may already have reached the sink.
pub error StreamErrors = {
    key,
    header,
    budget,
    unsupported,
    no_match,
    hmac,
    tag,
    truncated,
    io,
    entropy_unqualified,
}

fn add_count(total: int, n: int) -> int ! {budget} {
    if total < 0 || n < 0 || total > 9223372036854775807 - n { return budget }
    total + n
}

// Fill to the requested bound, continuing short reads. true means explicit
// EOF, not a short read. A successful zero-progress read is an I/O failure.
fn fill(mut source: fs.File, mut dst: List[byte], limit: int) -> bool ! {io} {
    var part = List[byte]()
    while dst.len < limit {
        let n = fs.read_into(mut source, mut part, limit - dst.len) else |e| match e {
            eof => { return true },
            io => { return io },
        }
        if n <= 0 || n > limit - dst.len { return io }
        append(mut dst, part)
    }
    false
}

// Retry short writes, but never zero progress. A per-attempt region prevents
// one-byte writes from retaining successively shorter slice copies.
fn write_all(mut sink: fs.File, data: List[byte]) -> () ! {io} {
    var at = 0
    while at < data.len {
        var n = 0
        region write_attempt {
            n = fs.write_some(mut sink, data[at..data.len]) else |_| { return io }
        }
        if n <= 0 || n > data.len - at { return io }
        at += n
    }
}

fn read_header(mut source: fs.File) -> Header ! StreamErrors {
    var raw = List[byte]()
    var one = List[byte]()
    var start = 0
    while raw.len < 1048576 {
        let n = fs.read_into(mut source, mut one, 1) else |e| match e {
            eof => { return truncated },
            io => { return io },
        }
        if n != 1 { return io }
        (mut raw).push(one[0])
        if one[0] == 10 as byte {
            if raw.len - start >= 4 &&
                raw[start] == 45 as byte &&
                raw[start + 1] == 45 as byte &&
                raw[start + 2] == 45 as byte {
                return parse_header(raw)?
            }
            start = raw.len
        }
        if raw.len - start >= 4096 { return budget }
    }
    budget
}

fn stream_nonce(counter: List[byte], final: bool) -> List[byte] {
    var nonce = copy counter
    (mut nonce).push(if final { 1 as byte } else { 0 as byte })
    nonce
}

/// Encrypt source bytes to the caller's ciphertext sink, without choosing,
/// closing, syncing or publishing files. Return the complete plaintext count
/// only after the authenticated final chunk is written. Caller owns abort and
/// private partial cleanup on every error/interruption. No entropy injection.
pub fn encrypt(
    mut source: fs.File,
    mut sink: fs.File,
    recipients: List[List[byte]],
) -> int ! StreamErrors {
    let created = create_header(recipients)?
    let payload_key = sha2.hkdf256(created.payload_nonce, created.file_key, "payload".bytes(), 32)
    write_all(mut sink, created.raw)?
    write_all(mut sink, created.payload_nonce)?
    var in_count = 0
    var out_count = created.raw.len + 16
    var counter = zeros(11)
    var carry = 0 - 1
    while true {
        region chunk {
            var plain = List[byte]()
            if carry >= 0 { (mut plain).push(carry as byte) }
            var final = fill(mut source, mut plain, 65536)?
            carry = 0 - 1
            if !final {
                var look = List[byte]()
                final = fill(mut source, mut look, 1)?
                if !final { carry = look[0] as int }
            }
            in_count = add_count(in_count, plain.len)?
            out_count = add_count(out_count, plain.len + 16)?
            let boxed = chacha20.seal(
                payload_key,
                stream_nonce(counter, final),
                List[byte](),
                plain,
            )
            write_all(mut sink, boxed)?
            if final { return in_count }
            advance_counter(mut counter)?
        }
    }
    // A loop exit is unreachable; never turn it into stream success.
    truncated
}

/// Authenticate a whole header, then each complete chunk before writing its
/// plaintext. Decryption has no entropy prerequisite. Require final AEAD plus
/// immediate EOF, rejecting appended bytes/second files. The caller's sink is
/// an internal verification sink, never authority to mutate a restore target.
pub fn decrypt(
    mut source: fs.File,
    mut sink: fs.File,
    identities: List[List[byte]],
) -> int ! StreamErrors {
    let parsed = read_header(mut source)?
    let file_key = open_header(parsed, identities)?
    var payload_nonce = List[byte]()
    if fill(mut source, mut payload_nonce, 16)? { return truncated }
    let payload_key = sha2.hkdf256(payload_nonce, file_key, "payload".bytes(), 32)
    var in_count = parsed.transcript.len + 45 + 16
    var out_count = 0
    var counter = zeros(11)
    while true {
        region chunk {
            var boxed = List[byte]()
            let ended = fill(mut source, mut boxed, 65552)?
            in_count = add_count(in_count, boxed.len)?
            if boxed.len < 16 { return truncated }
            if boxed.len == 16 && out_count != 0 { return truncated }
            // A full chunk can authenticate as nonfinal or final. Do not
            // make release of a verified full chunk depend on later bytes:
            // published failure vectors require its authenticated prefix.
            var final = ended
            var plain = List[byte]()
            if !final {
                plain = chacha20.open(
                    payload_key,
                    stream_nonce(counter, false),
                    List[byte](),
                    boxed,
                ) else |tag| {
                    final = true
                    List[byte]()
                }
            }
            if final {
                plain = chacha20.open(
                    payload_key,
                    stream_nonce(counter, true),
                    List[byte](),
                    boxed,
                )?
            }
            out_count = add_count(out_count, plain.len)?
            write_all(mut sink, plain)?
            if final {
                if !ended {
                    var extra = List[byte]()
                    if !fill(mut source, mut extra, 1)? { return truncated }
                }
                return out_count
            }
            advance_counter(mut counter)?
        }
    }
    truncated
}
